# React shell configuration — copy to `.env` and adjust if your ports differ.
#
# Finding A-5: the legacy client hardcodes http://localhost:3000 in two places
# (app/app.js:14 and app/services/auth.service.js:18). The React client reads
# its API base URL from the environment and nowhere else. There is no literal
# fallback in src/ — a silent default is how a hardcoded origin creeps back in.

# Where the browser sends API calls. Left as a same-origin path so requests go
# through the front door and are proxied to the mock API, which keeps ONE
# origin and therefore one localStorage (see vite.config.ts).
VITE_API_URL=/api

# The mock API the front door proxies /api to (api-mock/server.js).
VITE_API_PROXY_TARGET=http://localhost:3000

# The legacy AngularJS static server the front door proxies everything
# unmigrated to (grunt connect, Gruntfile.js:78).
VITE_LEGACY_URL=http://localhost:8080
